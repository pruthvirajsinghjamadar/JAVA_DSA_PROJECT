# ==========================================================
# Java + DSA Platform - Environment Variables
# Free Deployment Stack: Vercel + Neon/Supabase Postgres + Google Auth
# ==========================================================

# 1. NextAuth / Auth Configuration
# Generate a secret by running: openssl rand -base64 32 (or any random string for local development)
NEXTAUTH_SECRET=your_nextauth_secret_here_random_string_32_chars
NEXTAUTH_URL=http://localhost:3000
# When deployed to Vercel, set NEXTAUTH_URL to your Vercel URL, e.g. https://your-project.vercel.app

# 2. Google OAuth 2.0 Credentials (100% Free from Google Cloud Console)
# Obtain these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=440915672466-jo9c676lskijomb66g5pu8vknts1d2c2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# 3. PostgreSQL Database Connection URL (100% Free from Neon.tech or Supabase.com)
# e.g., postgres://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# 4. Admin Secret Key (for accessing /admin dashboard)
ADMIN_KEY=admin123